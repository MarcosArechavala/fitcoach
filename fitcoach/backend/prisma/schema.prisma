generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  TRAINER
  STUDENT
}

enum StudentStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PlanModality {
  ONLINE
  IN_PERSON
  HYBRID
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum ExerciseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum PaymentMethod {
  CASH
  TRANSFER
  MERCADO_PAGO
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  DISCARDED
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String?
  role                UserRole  @default(STUDENT)
  isActive            Boolean   @default(true)
  invitationTokenHash String?   @unique
  invitationExpiresAt DateTime?
  resetTokenHash      String?   @unique
  resetExpiresAt      DateTime?
  lastLoginAt         DateTime?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  trainerProfile TrainerProfile?
  studentProfile StudentProfile?

  @@index([role, isActive])
  @@index([deletedAt])
}

model TrainerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  slug            String   @unique
  firstName       String
  lastName        String
  headline        String?
  bio             String?
  philosophy      String?
  experienceYears Int      @default(1)
  certifications  Json?
  phone           String?
  whatsapp        String?
  instagram       String?
  avatarUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteSettings     SiteSettings?
  students         StudentProfile[]
  servicePlans     ServicePlan[]
  exercises        Exercise[]
  workoutTemplates WorkoutTemplate[]
  appointments     Appointment[]
  payments         Payment[]
  leads            ContactLead[]
}

model StudentProfile {
  id              String          @id @default(cuid())
  userId          String          @unique
  trainerId       String?
  firstName       String
  lastName        String
  phone           String?
  birthDate       DateTime?
  heightCm        Int?
  currentWeightKg Decimal?        @db.Decimal(5, 2)
  goal            String?
  experienceLevel ExperienceLevel @default(BEGINNER)
  status          StudentStatus   @default(ACTIVE)
  joinedAt        DateTime        @default(now())
  notes           String?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainer          TrainerProfile?       @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  subscriptions    StudentSubscription[]
  assignments      WorkoutAssignment[]
  workoutSessions  WorkoutSession[]
  bodyMeasurements BodyMeasurement[]
  appointments     Appointment[]
  payments         Payment[]

  @@index([trainerId, status, deletedAt])
  @@index([status, deletedAt])
  @@index([lastName, firstName])
}

model ServicePlan {
  id          String       @id @default(cuid())
  trainerId   String?
  name        String
  slug        String
  badge       String?
  description String?
  priceArs    Int
  modality    PlanModality @default(ONLINE)
  features    Json?
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  trainer       TrainerProfile?       @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  subscriptions StudentSubscription[]
  payments      Payment[]

  @@unique([trainerId, slug])
  @@index([trainerId, isActive])
}

model StudentSubscription {
  id            String             @id @default(cuid())
  studentId     String
  servicePlanId String
  status        SubscriptionStatus @default(ACTIVE)
  startDate     DateTime           @default(now())
  endDate       DateTime?
  customPriceArs Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  servicePlan ServicePlan    @relation(fields: [servicePlanId], references: [id])

  @@index([studentId, status])
}

model Exercise {
  id           String             @id @default(cuid())
  trainerId    String?
  name         String
  muscleGroup  String
  equipment    String?
  difficulty   ExerciseDifficulty @default(INTERMEDIATE)
  description  String?
  instructions String?
  mediaUrl     String?
  isArchived   Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  trainer          TrainerProfile?   @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercise[]

  @@index([trainerId, muscleGroup, isArchived])
  @@index([muscleGroup, isArchived])
}

model WorkoutTemplate {
  id          String   @id @default(cuid())
  trainerId   String?
  name        String
  description String?
  goal        String?
  weeksCount  Int      @default(4)
  isTemplate  Boolean  @default(true)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trainer     TrainerProfile?     @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  days        WorkoutDay[]
  assignments WorkoutAssignment[]

  @@index([trainerId, deletedAt])
}

model WorkoutDay {
  id         String   @id @default(cuid())
  templateId String
  weekNumber Int      @default(1)
  dayNumber  Int
  title      String
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template  WorkoutTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]
  sessions  WorkoutSession[]

  @@index([templateId, weekNumber, dayNumber])
}

model WorkoutExercise {
  id             String   @id @default(cuid())
  workoutDayId   String
  exerciseId     String
  sortOrder      Int
  sets           Int
  reps           String
  targetWeightKg Decimal? @db.Decimal(6, 2)
  restSeconds    Int      @default(90)
  rpeOrRir       String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workoutDay WorkoutDay       @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  exercise   Exercise         @relation(fields: [exerciseId], references: [id])
  setLogs    ExerciseSetLog[]

  @@index([workoutDayId, sortOrder])
}

model WorkoutAssignment {
  id         String    @id @default(cuid())
  studentId  String
  templateId String
  startDate  DateTime  @default(now())
  endDate    DateTime?
  isActive   Boolean   @default(true)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  student  StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  template WorkoutTemplate @relation(fields: [templateId], references: [id])
  sessions WorkoutSession[]

  @@index([studentId, isActive])
}

model WorkoutSession {
  id           String        @id @default(cuid())
  studentId    String
  assignmentId String?
  workoutDayId String?
  dayTitleSnap String
  startedAt    DateTime      @default(now())
  completedAt  DateTime?
  status       SessionStatus @default(IN_PROGRESS)
  studentNotes String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  student    StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignment WorkoutAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  workoutDay WorkoutDay?        @relation(fields: [workoutDayId], references: [id], onDelete: SetNull)
  setLogs    ExerciseSetLog[]

  @@index([studentId, startedAt])
}

model ExerciseSetLog {
  id                String   @id @default(cuid())
  sessionId         String
  workoutExerciseId String?
  exerciseNameSnap  String
  setNumber         Int
  weightKg          Decimal? @db.Decimal(6, 2)
  repsCompleted     Int
  rpe               Decimal? @db.Decimal(3, 1)
  isCompleted       Boolean  @default(true)
  notes             String?
  createdAt         DateTime @default(now())

  session         WorkoutSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workoutExercise WorkoutExercise? @relation(fields: [workoutExerciseId], references: [id], onDelete: SetNull)

  @@index([sessionId, setNumber])
}

model BodyMeasurement {
  id         String   @id @default(cuid())
  studentId  String
  recordedAt DateTime @default(now())
  weightKg   Decimal? @db.Decimal(5, 2)
  bodyFatPct Decimal? @db.Decimal(4, 1)
  chestCm    Decimal? @db.Decimal(5, 1)
  waistCm    Decimal? @db.Decimal(5, 1)
  hipCm      Decimal? @db.Decimal(5, 1)
  armCm      Decimal? @db.Decimal(5, 1)
  thighCm    Decimal? @db.Decimal(5, 1)
  notes      String?
  photoUrl   String?
  createdAt  DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, recordedAt])
}

model Appointment {
  id              String            @id @default(cuid())
  trainerId       String?
  studentId       String
  title           String
  modality        PlanModality      @default(IN_PERSON)
  scheduledAt     DateTime
  durationMinutes Int               @default(60)
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  trainer TrainerProfile? @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  student StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([trainerId, scheduledAt, status])
  @@index([scheduledAt, status])
  @@index([studentId, scheduledAt])
}

model Payment {
  id            String        @id @default(cuid())
  trainerId     String?
  studentId     String
  servicePlanId String?
  amountArs     Int
  method        PaymentMethod @default(TRANSFER)
  status        PaymentStatus @default(PENDING)
  dueDate       DateTime
  paidAt        DateTime?
  periodLabel   String?
  externalRef   String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  trainer     TrainerProfile? @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  student     StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  servicePlan ServicePlan?    @relation(fields: [servicePlanId], references: [id], onDelete: SetNull)

  @@index([trainerId, status, dueDate])
  @@index([studentId, status])
  @@index([dueDate, status])
}

model ContactLead {
  id        String     @id @default(cuid())
  trainerId String?
  name      String
  email     String
  whatsapp  String
  goal      String
  message   String
  status    LeadStatus @default(NEW)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  trainer TrainerProfile? @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, status, createdAt])
  @@index([status, createdAt])
}

model SiteSettings {
  id           String   @id @default(cuid())
  trainerId    String?  @unique
  brandName    String   @default("FITCOACH")
  tagline      String   @default("Entrenamiento Personalizado")
  location     String   @default("Buenos Aires, Argentina")
  whatsapp     String   @default("5491155550199")
  email        String   @default("hola@fitcoach.com.ar")
  instagram    String?  @default("@fitcoach.ar")
  primaryColor String   @default("#B8F34B")
  logoUrl      String?
  scheduleText String?  @default("Lunes a Sábado de 07:00 a 21:00 hs")
  updatedAt    DateTime @updatedAt

  trainer TrainerProfile? @relation(fields: [trainerId], references: [id], onDelete: Cascade)
}
