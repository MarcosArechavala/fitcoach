NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# PostgreSQL connection string (reemplazar con las credenciales de tu proveedor, ej. Neon / Supabase)
DATABASE_URL="postgresql://USUARIO:PASSWORD@ep-xyz.sa-east-1.aws.neon.tech/fitcoach_db?sslmode=require"

# JWT & Cookie signing (generar secreto seguro de al menos 32 caracteres en producción con: openssl rand -hex 32)
JWT_SECRET="reemplazar_con_un_secreto_aleatorio_de_minimo_32_caracteres"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="fitcoach_session"

# Seed inicial (usar únicamente para crear el primer entrenador administrador)
SEED_TRAINER_EMAIL="coach@fitcoach.com.ar"
SEED_TRAINER_PASSWORD="CambiarEstaPassword123!"
